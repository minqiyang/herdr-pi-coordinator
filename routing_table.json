      "AUDIT",
      "GROK_REVIEW"
    ]
  },
  "routes": {
    "COORD": {
      "capability": "control-namespace coordination and deterministic verification",
      "capability_class": "coordination",
      "default": true,
      "may_author_plan": false,
      "may_formally_review": false,
      "primary": {
        "model": "live_pi_session",
        "harness": "Pi"
      }
    },
    "GENERAL_EXEC": {
      "capability": "ordinary implementation, debugging, fixing, integration, and interaction logic",
      "capability_class": "implementation",
      "default": true,
      "may_author_plan": false,
      "may_formally_review": false,
      "binding_ref": "general_execution_model",
      "prompt_constraints": [
        "scope_clamp"
      ]
    },
    "REVIEW": {
      "capability": "first formal review seat",
      "capability_class": "review",
      "default": true,
      "may_author_plan": false,
      "may_formally_review": true,
      "primary": {
        "model_ref": "GEMINI_FLASH_LATEST",
        "harness": "Antigravity",
        "default_effort": "HIGH",
        "allowed_effort_band": [
          "HIGH"
        ]
      }
    },
    "DESIGN": {
      "capability": "required architecture or interface decisions and binding-plan authorship; excludes ordinary implementation planning, local code adjustments, and bug-cause analysis",
      "capability_class": "design",
      "default": false,
      "may_author_plan": true,
      "may_formally_review": false,
      "dispatch_triggers": [
        {
          "trigger_id": "DESIGN_BINDING_PLAN_AUTHOR",
          "when": "card_requires_binding_plan_authorship"
        },
        {
          "trigger_id": "DESIGN_ARCHITECTURE_DECISION",
          "when": "required_deliverable_is_a_formal_architecture_or_interface_decision_not_ordinary_implementation_planning_local_code_adjustment_or_bug_cause_analysis"
        }
      ],
      "prompt_constraints": [
        "scope_clamp"
      ],
      "quota_binding_order_ref": "problem_solving_quota_order"
    },
    "EXPERT": {
      "capability": "final problem-solving escalation for unresolved design, architecture, planning, analysis, or implementation",
      "capability_class": "problem_solving",
      "default": false,
      "may_author_plan": true,
      "may_formally_review": false,
      "dispatch_triggers": [
        {
          "trigger_id": "EVIDENCED_BLOCKER_PERSISTS",
          "when": "same_blocker_remains_after_required_qualifying_attempts_with_no_clear_general_fix_next_step_and_environment_permission_quota_and_requirement_ambiguity_causes_ruled_out",
          "minimum_qualifying_attempts": 4
        },
        {
          "trigger_id": "USER_REQUESTED_EXPERT",
          "when": "user_explicitly_requests_expert_escalation_for_this_task"
        }
      ],
      "prompt_constraints": [
        "scope_clamp"
      ],
      "quota_binding_order_ref": "problem_solving_quota_order"
    },
    "FRONTEND": {
      "capability": "aesthetic, visual, and art-direction design only",
      "capability_class": "implementation",
      "default": false,
      "may_author_plan": false,
      "may_formally_review": false,
      "dispatch_triggers": [
        {
          "trigger_id": "FRONTEND_DESIGN_SYSTEM",
          "when": "card_output_is_design_system_tokens_or_visual_language"
        },
        {
          "trigger_id": "FRONTEND_HIGH_FIDELITY",
          "when": "card_output_is_high_fidelity_visual_composition"
        },
        {
          "trigger_id": "FRONTEND_ART_DIRECTION",
          "when": "card_output_is_art_direction_or_aesthetic_authority"
        }
      ],
      "primary": {
        "model_ref": "OPUS_LATEST",
        "harness": "Cursor",
        "default_effort": "XHIGH",
        "allowed_effort_band": [
          "XHIGH"
        ]
      },
      "prompt_constraints": [
        "scope_clamp"
      ],
      "hard_constraints": [
        "no_implementation_or_interaction_logic",
        "no_review_or_audit_seat",
        "no_plan_authorship"
      ]
    },
    "AUDIT": {
      "capability": "second formal review seat and deep failure audit",
      "capability_class": "review",
      "default": true,
      "may_author_plan": false,
      "may_formally_review": true,
      "primary": {
        "model_ref": "GPT_LATEST",
        "harness": "Codex",
        "effort_profile_ref": "GPT_STANDARD"
      }
    },
    "GROK_REVIEW": {
      "capability": "independent formal review seat for STANDARD and CRITICAL candidates, including structural work and binding plans",
      "capability_class": "review",
      "default": true,
      "may_author_plan": false,
      "may_formally_review": true,
      "selection_rules": [
        {
          "rule_id": "GROK_REVIEW_STANDARD",
          "when": {
            "lane": "STANDARD"
          },
          "binding": {
            "model_ref": "GROK_LATEST",
            "harness": "Grok Build",
            "default_effort": "HIGH",
            "allowed_effort_band": [
              "HIGH"
            ]
          }
        },
        {
          "rule_id": "GROK_REVIEW_CRITICAL",
          "when": {
            "lane": "CRITICAL"
          },
          "binding": {
            "model_ref": "GROK_LATEST",
            "harness": "Grok Build",
            "default_effort": "XHIGH",
            "allowed_effort_band": [
              "XHIGH"
            ]
          }
        }
      ]
    },
    "PROSE": {
      "capability": "prose delivery: articles, documentation, explanations, and presentation of established conclusions; excludes binding-plan authorship and formal review judgment",
      "capability_class": "prose",
      "default": true,
      "may_author_plan": false,
      "may_formally_review": false,
      "mandatory_route_conditions": [
        {
          "condition_id": "PROSE_FOUR_OR_MORE_SENTENCES",
          "when": "work_is_prose_delivery_and_output_is_article_documentation_or_explanation_or_expected_to_contain_four_or_more_sentences"
        }
      ],
      "dispatch_triggers": [
        {
          "trigger_id": "PROSE_SPLIT_MIXED_CARD",
          "when": "card_mixes_nonprose_work_with_required_prose_delivery",
          "action": "split_the_prose_into_a_separate_PROSE_card"
        }
      ],
      "primary": {
        "model_ref": "GEMINI_FLASH_LATEST",
        "harness": "Antigravity",
        "default_effort": "HIGH",
        "allowed_effort_band": [
          "HIGH"
        ]
      }
    }
  },
  "scope_clamp": "Stay strictly within this card's objective, authority, read scope, and write scope. If additional work is required, state the missing scope in one line and stop. Do not perform that additional work.",
  "problem_solving_quota_order": [
    "highest_capability_model",
    "highest_capability_quota_alternative",
    "general_execution_model"
  ],
