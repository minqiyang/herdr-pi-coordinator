      "capability": "required architecture or interface decisions and binding-plan authorship; excludes ordinary implementation planning, local code adjustments, and bug-cause analysis",
      "capability_class": "design",
      "default": false,
      "may_author_plan": true,
      "may_formally_review": false,
      "dispatch_triggers": [
        {
          "trigger_id": "DESIGN_BINDING_PLAN_AUTHOR",
          "when": "card_requires_binding_plan_authorship"
        },
        {
          "trigger_id": "DESIGN_ARCHITECTURE_DECISION",
          "when": "required_deliverable_is_a_formal_architecture_or_interface_decision_not_ordinary_implementation_planning_local_code_adjustment_or_bug_cause_analysis"
        }
      ],
      "prompt_constraints": [
        "scope_clamp"
      ],
      "quota_binding_order_ref": "problem_solving_quota_order"
    },
    "EXPERT": {
      "capability": "final problem-solving escalation for unresolved design, architecture, planning, analysis, or implementation",
      "capability_class": "problem_solving",
      "default": false,
      "may_author_plan": true,
      "may_formally_review": false,
      "dispatch_triggers": [
        {
          "trigger_id": "EVIDENCED_BLOCKER_PERSISTS",
          "when": "same_blocker_remains_after_required_qualifying_attempts_with_no_clear_general_fix_next_step_and_environment_permission_quota_and_requirement_ambiguity_causes_ruled_out",
          "minimum_qualifying_attempts": 2
        },
        {
          "trigger_id": "USER_REQUESTED_EXPERT",
          "when": "user_explicitly_requests_expert_escalation_for_this_task"
        },
        {
          "trigger_id": "EXPERT_REPAIR_CONTINUATION",
          "when": "same_previously_escalated_core_problem_remains_or_evidence_shows_repairs_are_worsening_it_and_coordinator_records_expert_continuation"
